package com.veil.extendedscripts.properties;

import com.veil.extendedscripts.ClientTransferStorage;
import cpw.mods.fml.common.network.simpleimpl.IMessage;
import cpw.mods.fml.common.network.simpleimpl.IMessageHandler;
import cpw.mods.fml.common.network.simpleimpl.MessageContext;
import io.netty.buffer.ByteBuf;
import net.minecraft.client.Minecraft;
import net.minecraft.entity.player.EntityPlayer;

public class PlayerPropertyUpdateMessage implements IMessage {
    // Player attributes
    private float flightSpeedHorizontal = 0.0f;
    private float flightSpeedVertical = 0.0f;
    private float water_swim_boost = 0.0f;
    private float lava_swim_boost = 0.0f;
    private float extra_armor = 0.0f;
    private boolean canFly = false;
    private boolean lastSeenFlying = false;
    private boolean keepInventory = false;
    private float attackReach = 3;

    // Entity attributes
    private float gravity = 1.0f;
    private float downwardGravity = -1.0f;
    private float upwardGravity = -1.0f;
    private float underwaterGravity = 1.0f;
    private float underwaterDownwardGravity = -1.0f;
    private float underwaterUpwardGravity = -1.0f;
    private float jumpPowerVertical = 0.0f;
    private float jumpPowerHorizontal = 0.0f;
    private float maxFallDistance = 0.0f;
    private boolean canMove = true;

    public PlayerPropertyUpdateMessage() {} // Required default constructor

    public PlayerPropertyUpdateMessage(ExtendedScriptPlayerProperties props) {
        // Player properties
        this.flightSpeedHorizontal = props.get(PlayerAttribute.FLIGHT_SPEED_HORIZONTAL);
        this.flightSpeedVertical = props.get(PlayerAttribute.FLIGHT_SPEED_VERTICAL);
        this.water_swim_boost = props.get(PlayerAttribute.SWIM_BOOST_WATER);
        this.lava_swim_boost = props.get(PlayerAttribute.SWIM_BOOST_LAVA);
        this.extra_armor = props.get(PlayerAttribute.ARMOR_VALUE);
        this.canFly = props.get(PlayerAttribute.CAN_FLY);
        this.lastSeenFlying = props.get(PlayerAttribute.LAST_SEEN_FLYING);
        this.keepInventory = props.get(PlayerAttribute.KEEP_INVENTORY);
        this.attackReach = props.get(PlayerAttribute.ATTACK_REACH);

        // Entity properties
        this.gravity = props.get(EntityAttribute.GRAVITY);
        this.downwardGravity = props.get(EntityAttribute.DOWNWARD_GRAVITY);
        this.upwardGravity = props.get(EntityAttribute.UPWARD_GRAVITY);
        this.underwaterGravity = props.get(EntityAttribute.UNDERWATER_GRAVITY);
        this.underwaterDownwardGravity = props.get(EntityAttribute.UNDERWATER_DOWNWARD_GRAVITY);
        this.underwaterUpwardGravity = props.get(EntityAttribute.UNDERWATER_UPWARD_GRAVITY);
        this.jumpPowerVertical = props.get(EntityAttribute.JUMP_POWER_VERTICAL);
        this.jumpPowerHorizontal = props.get(EntityAttribute.JUMP_POWER_HORIZONTAL);
        this.maxFallDistance = props.get(EntityAttribute.MAX_FALL_DISTANCE);
        this.canMove = props.get(EntityAttribute.CAN_MOVE);
    }

    @Override
    public void fromBytes(ByteBuf buf) {
        // Player attributes
        this.flightSpeedHorizontal = buf.readFloat();
        this.flightSpeedVertical = buf.readFloat();
        this.water_swim_boost = buf.readFloat();
        this.lava_swim_boost = buf.readFloat();
        this.extra_armor = buf.readFloat();
        this.canFly = buf.readBoolean();
        this.lastSeenFlying = buf.readBoolean();
        this.keepInventory = buf.readBoolean();
        this.attackReach = buf.readFloat();

        // Entity attributes
        this.gravity = buf.readFloat();
        this.downwardGravity = buf.readFloat();
        this.upwardGravity = buf.readFloat();
        this.underwaterGravity = buf.readFloat();
        this.underwaterDownwardGravity = buf.readFloat();
        this.underwaterUpwardGravity = buf.readFloat();
        this.jumpPowerVertical = buf.readFloat();
        this.jumpPowerHorizontal = buf.readFloat();
        this.maxFallDistance = buf.readFloat();
        this.canMove = buf.readBoolean();
    }

    @Override
    public void toBytes(ByteBuf buf) {
        // Player attributes
        buf.writeFloat(this.flightSpeedHorizontal);
        buf.writeFloat(this.flightSpeedVertical);
        buf.writeFloat(this.water_swim_boost);
        buf.writeFloat(this.lava_swim_boost);
        buf.writeFloat(this.extra_armor);
        buf.writeBoolean(this.canFly);
        buf.writeBoolean(this.lastSeenFlying);
        buf.writeBoolean(this.keepInventory);
        buf.writeFloat(this.attackReach);

        // Entity attributes
        buf.writeFloat(this.gravity);
        buf.writeFloat(this.downwardGravity);
        buf.writeFloat(this.upwardGravity);
        buf.writeFloat(this.underwaterGravity);
        buf.writeFloat(this.underwaterDownwardGravity);
        buf.writeFloat(this.underwaterUpwardGravity);
        buf.writeFloat(this.jumpPowerVertical);
        buf.writeFloat(this.jumpPowerHorizontal);
        buf.writeFloat(this.maxFallDistance);
        buf.writeBoolean(this.canMove);
    }

    public static class PlayerPropertyUpdateMessageHandler implements IMessageHandler<PlayerPropertyUpdateMessage, IMessage> {
        @Override
        public IMessage onMessage(final PlayerPropertyUpdateMessage message, final MessageContext ctx) {
            // This method is called on the receiving side (CLIENT in this case)
            Minecraft.getMinecraft().func_152344_a(new Runnable() {
                @Override
                public void run() {
                    EntityPlayer player = Minecraft.getMinecraft().thePlayer; // Get the client player
                    if (player != null) {
                        ExtendedScriptPlayerProperties props = ExtendedScriptPlayerProperties.get(player);
                        if (props != null) {
                            // Player attributes
                            props.set(PlayerAttribute.FLIGHT_SPEED_HORIZONTAL, message.flightSpeedHorizontal);
                            props.set(PlayerAttribute.FLIGHT_SPEED_VERTICAL, message.flightSpeedVertical);
                            props.set(PlayerAttribute.SWIM_BOOST_WATER, message.water_swim_boost);
                            props.set(PlayerAttribute.SWIM_BOOST_LAVA, message.lava_swim_boost);
                            props.set(PlayerAttribute.ARMOR_VALUE, message.extra_armor);
                            props.set(PlayerAttribute.CAN_FLY, message.canFly);
                            props.set(PlayerAttribute.LAST_SEEN_FLYING, message.lastSeenFlying);
                            props.set(PlayerAttribute.KEEP_INVENTORY, message.keepInventory);
                            props.set(PlayerAttribute.ATTACK_REACH, message.attackReach);

                            // Entity attributes
                            props.set(EntityAttribute.GRAVITY, message.gravity);
                            props.set(EntityAttribute.DOWNWARD_GRAVITY, message.downwardGravity);
                            props.set(EntityAttribute.UPWARD_GRAVITY, message.upwardGravity);
                            props.set(EntityAttribute.UNDERWATER_GRAVITY, message.underwaterGravity);
                            props.set(EntityAttribute.UNDERWATER_DOWNWARD_GRAVITY, message.underwaterDownwardGravity);
                            props.set(EntityAttribute.UNDERWATER_UPWARD_GRAVITY, message.underwaterUpwardGravity);
                            props.set(EntityAttribute.JUMP_POWER_VERTICAL, message.jumpPowerVertical);
                            props.set(EntityAttribute.JUMP_POWER_HORIZONTAL, message.jumpPowerHorizontal);
                            props.set(EntityAttribute.MAX_FALL_DISTANCE, message.maxFallDistance);
                            props.set(EntityAttribute.CAN_MOVE, message.canMove);

                            ClientTransferStorage.attackReach = message.attackReach;

                            if (!player.capabilities.isCreativeMode) {
                                player.capabilities.allowFlying = message.canFly;
                            }

                            player.capabilities.setFlySpeed(0.05F + message.flightSpeedHorizontal / 20);
                            player.sendPlayerAbilities();

                            System.out.println("Client received attribute packet data");
                        } else {
                            System.out.println("Extended Player Properties was unexpectedly null");
                        }
                    } else {
                        System.out.println("Client player was unexpectedly null");
                    }
                }
            });
            return null;
        }
    }
}
